rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Existing admins retain their permissions; super-admins are also privileged.
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role in ['super_admin','admin'];
    }
    // Editors and publishers may upload without receiving delete/list privileges.
    function canUploadMedia() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role in ['super_admin','admin','publisher','editor'];
    }
    match /public/{allPaths=**} {
      // Keep known public asset URLs readable but prevent public enumeration.
      allow get: if true;
      allow list: if isAdmin();
      // Draft editors/publishers may add new assets, but cannot replace an
      // existing public image that may already appear on the live website.
      // Defense-in-depth for Storage operations that appear as 'create' on overwrite.
      allow create: if resource == null && canUploadMedia() && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow update: if isAdmin() && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if isAdmin();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
