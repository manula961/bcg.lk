rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Existing admins retain their permissions; super-admins are also privileged.
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role in ['super_admin','admin'];
    }
    // Direct Storage writes are admin-only. Publishers and draft editors can
    // still upload approved media through the role-checked Google Drive API.
    // This avoids relying on Storage emulator create/overwrite distinctions
    // that may allow a non-admin to replace an existing public asset.
    function canUploadMedia() {
      return isAdmin();
    }
    match /public/{allPaths=**} {
      // Keep known public asset URLs readable but prevent public enumeration.
      allow get: if true;
      allow list: if isAdmin();
      // Both new objects and updates require privileged credentials.
      allow create: if canUploadMedia() && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow update: if isAdmin() && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if isAdmin();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
