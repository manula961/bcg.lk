VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Google Drive OAuth / Vercel server-side functions (never prefix secrets with VITE_)
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://bcglk.devoraid.com/api/drive/callback
DRIVE_COOKIE_ENCRYPTION_KEY=
# Optional: must be a Drive folder accessible with the drive.file scope
GOOGLE_DRIVE_FOLDER_ID=


# Canonical HTTPS origin used at build time after school owner approval.
# Leave unset to preserve the existing canonical domain.
BCG_CANONICAL_ORIGIN=

# Firebase User Management (server-only; never set these as VITE_* variables)
# Must be the same existing project as FIREBASE_PROJECT_ID.
# Store the complete service-account JSON in the Vercel Environment Variables UI.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Exact HTTPS origin of the deployment allowed to make account changes.
USER_ADMIN_ORIGIN=https://bcglk.devoraid.com

# Optional branded admin account emails (server-only; do not use VITE_).
# When both are configured, Firebase generates links and Resend sends HTML emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=BCG.LK Administration <admin@mail.bcglk.devoraid.com>
RESEND_REPLY_TO=

# Public HTTPS image URLs for the two logos in outgoing HTML emails.
EMAIL_SCHOOL_LOGO_URL=
EMAIL_SOCIETY_LOGO_URL=

# Server-only scheduler bearer token. Configure matching GitHub Actions secret.
# Must be 32-256 random URL-safe characters; never prefix with VITE_.
CMS_CRON_SECRET=
# Enable strict scheduler presence check during authorized release validation.
BCG_REQUIRE_WORKFLOW_SCHEDULER=0

# Cloudflare Web Analytics (Vercel remains the host; independent account).
# Do not mix up site_tag (GraphQL filter) and site_token (public JS beacon).
# Site identifiers are usually 32 hexadecimal characters and may differ;
# verify both under Cloudflare Web Analytics > Manage site or Site Info API.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WEB_ANALYTICS_SITE_TOKEN=
CLOUDFLARE_WEB_ANALYTICS_SITE_TAG=
# Private server API token with Account > Account Analytics > Read only.
CLOUDFLARE_ANALYTICS_API_TOKEN=
# Opt-in read-only configuration preflight; set to 1 when validating production.
BCG_REQUIRE_CLOUDFLARE_ANALYTICS=0

# TEMPORARY PRODUCTION-ONLY release hold until GitHub branch protection and
# required Actions checks are enforced. Set this on Vercel Production ONLY to
# the exact 40-character merge/commit SHA approved for the next release.
# Keep unset in Preview; absence deliberately blocks NEW production builds.
# This does not replace independent human reviews or working CI.
BCG_APPROVED_PRODUCTION_SHA=
