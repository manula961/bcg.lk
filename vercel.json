{
  "rewrites": [
    {
      "source": "/about-us",
      "destination": "/about-us/index.html"
    },
    {
      "source": "/events",
      "destination": "/events/index.html"
    },
    {
      "source": "/past-papers",
      "destination": "/past-papers/index.html"
    },
    {
      "source": "/life/about-us",
      "destination": "/life/about-us/index.html"
    },
    {
      "source": "/life/academic-excellence",
      "destination": "/life/academic-excellence/index.html"
    },
    {
      "source": "/life/sports-societies",
      "destination": "/life/sports-societies/index.html"
    },
    {
      "source": "/life/leadership",
      "destination": "/life/leadership/index.html"
    },
    {
      "source": "/((?!api/)(?!audio/)(?!assets/)(?!email-assets/)(?![^/]+\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-FRUT/5dD9NEMa7IBfC8amlq0nvts4L0JvqV8MONCSzw=' https://static.cloudflareinsights.com https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; media-src 'self' blob: https:; frame-src https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
