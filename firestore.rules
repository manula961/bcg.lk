rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function role() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role
        : null;
    }
    // Existing "admin" accounts keep full content permissions.
    function isAdmin() { return role() in ['admin', 'super_admin']; }
    function isSuperAdmin() { return role() == 'super_admin'; }
    function canReview() { return role() in ['super_admin', 'admin', 'publisher', 'editor', 'auditor']; }
    function canWriteContent() { return role() in ['super_admin', 'admin', 'publisher', 'editor']; }
    function canPublishContent() { return role() in ['super_admin', 'admin', 'publisher']; }
    function canDeleteContent() { return isAdmin(); }
    function validManagedRole(name) {
      return name in ['admin', 'publisher', 'editor', 'auditor'];
    }
    // The first super_admin is assigned by a trusted console or Admin SDK.
    // No client may grant super_admin, edit their own role, or change another super_admin.
    function validRoleProvision(uid) {
      return uid.matches('^[A-Za-z0-9_-]{1,128}$')
        && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['role','createdAt','createdBy','updatedAt','updatedBy'])
        && validManagedRole(request.resource.data.role)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function validRoleUpdate(uid) {
      return uid != request.auth.uid
        && resource.data.role != 'super_admin'
        && validManagedRole(request.resource.data.role)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','updatedAt','updatedBy'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function editorDraftUpdateOnly() {
      return resource.data.published == false
        && request.resource.data.published == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title','excerpt','body','category','tag','imageUrl','description',
          'eventDate','location','color','slug','seoDescription',
          'websiteUrl','achievements','role','exam','subject','year','language','term','url','updatedAt','updatedBy'
        ]);
    }
    function optionalString(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }
    // The CMS requires real, nonempty content, even when a direct SDK is used.
    function requiredString(data, key, max) {
      return key in data && data[key] is string &&
        data[key].size() > 0 && data[key].size() <= max &&
        data[key].matches('(?s).*\\S.*');
    }
    function optionalBool(data, key) {
      return !(key in data) || data[key] is bool;
    }
    function optionalNumber(data, key) {
      return !(key in data) || data[key] == null || data[key] is number;
    }
    function optionalTimestamp(data, key) {
      return !(key in data) || data[key] == null || data[key] is timestamp;
    }
    // Enforce content data formats even for direct Firestore SDK requests.
    // Calendar date validity is additionally checked by the CMS client.
    function validHttpsUrl(data, key) {
      return !(key in data) || data[key] == '' ||
        (data[key] is string && data[key].matches('^https://[^@ ]+$'));
    }
    function validSlug(data) {
      return !('slug' in data) ||
        (data.slug is string && data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$'));
    }
    function validEventDate(data) {
      return !('eventDate' in data) ||
        (data.eventDate is string &&
         data.eventDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'));
    }
    function validHexColor(data) {
      return !('color' in data) ||
        (data.color is string && data.color.matches('^#[0-9a-fA-F]{6}$'));
    }
    function validNewsCategory(data) {
      return !('category' in data) || data.category in ['News', 'Announcements'];
    }
    function validLeaderRole(data) {
      return !('role' in data) ||
        data.role in ['Principal', 'Deputy Principal', 'Assistant Principal', 'Sectional Head', 'Other Senior Staff'];
    }
    function validCommon(data) {
      return requiredString(data, 'title', 180)
        && ('published' in data) && data.published is bool
        && optionalNumber(data, 'rank')
        && optionalString(data, 'imageUrl', 2048) && validHttpsUrl(data, 'imageUrl')
        && optionalTimestamp(data, 'createdAt')
        && optionalTimestamp(data, 'updatedAt')
        && optionalTimestamp(data, 'publishedAt')
        && optionalString(data, 'createdBy', 128)
        && optionalString(data, 'updatedBy', 128);
    }
    function validOwnership(data) {
      return (!('createdBy' in data) || data.createdBy == request.auth.uid)
        && (!('updatedBy' in data) || data.updatedBy == request.auth.uid);
    }
    function validUpdateOwnership() {
      return (!('createdBy' in resource.data) ||
        request.resource.data.createdBy == resource.data.createdBy)
        && (!('createdAt' in resource.data) ||
        request.resource.data.createdAt == resource.data.createdAt)
        && (!('updatedBy' in request.resource.data) ||
        request.resource.data.updatedBy == request.auth.uid);
    }
    function validRecord(data, collectionName, id) {
      return validCommon(data) &&
        (
          (collectionName == 'news' &&
            data.keys().hasOnly(['title','excerpt','body','category','tag','imageUrl','published','rank','createdAt','updatedAt','publishedAt','createdBy','updatedBy']) &&
            requiredString(data,'excerpt',500) && optionalString(data,'body',30000) &&
            optionalString(data,'category',32) && validNewsCategory(data) && optionalString(data,'tag',80))
          || (collectionName == 'events' &&
            data.keys().hasOnly(['title','description','eventDate','location','color','imageUrl','published','rank','createdAt','updatedAt','publishedAt','createdBy','updatedBy']) &&
            requiredString(data,'description',3000) && requiredString(data,'eventDate',10) &&
            requiredString(data,'location',200) && optionalString(data,'color',7) &&
            validEventDate(data) && validHexColor(data))
          || (collectionName == 'pages' &&
            data.keys().hasOnly(['slug','title','body','seoDescription','imageUrl','published','rank','createdAt','updatedAt','publishedAt','createdBy','updatedBy']) &&
            requiredString(data,'slug',120) && data.slug == id && requiredString(data,'body',50000) &&
            optionalString(data,'seoDescription',320) && validSlug(data))
          || (collectionName == 'societies' &&
            data.keys().hasOnly(['title','description','category','imageUrl','websiteUrl','published','rank','createdAt','updatedAt','publishedAt','createdBy','updatedBy']) &&
            requiredString(data,'description',1200) && optionalString(data,'category',80) &&
            optionalString(data,'websiteUrl',2048) && validHttpsUrl(data,'websiteUrl'))
          || (collectionName == 'sports' &&
            data.keys().hasOnly(['title','description','category','achievements','imageUrl','published','rank','createdAt','updatedAt','publishedAt','createdBy','updatedBy']) &&
            requiredString(data,'description',3000) && optionalString(data,'category',80) &&
            optionalString(data,'achievements',2000))
          || (collectionName == 'pastPapers' &&
            data.keys().hasOnly(['title','exam','subject','year','language','term','url','published','rank','createdAt','updatedAt','publishedAt','createdBy','updatedBy']) &&
            requiredString(data,'exam',40) && requiredString(data,'subject',120) &&
            requiredString(data,'year',4) && data.year.matches('^(19|20)[0-9]{2}
            data.keys().hasOnly(['title','description','role','imageUrl','published','rank','createdAt','updatedAt','publishedAt','createdBy','updatedBy']) &&
            optionalString(data,'description',1200) && requiredString(data,'role',80) && validLeaderRole(data))
        );
    }
    // Client append-only log: trusted Admin SDK changes need separate audit coverage.
    match /roleAudit/{eventId} {
      allow get, list: if isSuperAdmin();
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasAll(['actorUid','targetUid','action','beforeRole','afterRole','createdAt'])
        && request.resource.data.keys().hasOnly(['actorUid','targetUid','action','beforeRole','afterRole','createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.action in ['grant','change','revoke']
        && (request.resource.data.beforeRole == null || validManagedRole(request.resource.data.beforeRole))
        && (request.resource.data.afterRole == null || validManagedRole(request.resource.data.afterRole))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /admins/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() && validRoleProvision(uid);
      allow update: if isSuperAdmin() && validRoleUpdate(uid);
      allow delete: if isSuperAdmin() && uid != request.auth.uid
        && resource.data.role != 'super_admin';
    }
    match /{collectionName}/{id} {
      allow get, list: if collectionName in ['news','events','pages','societies','sports','leadership','pastPapers']
        && (canReview() || resource.data.published == true);
      allow create: if collectionName in ['news','events','pages','societies','sports','leadership']
        && canWriteContent() && validRecord(request.resource.data, collectionName, id)
        && validOwnership(request.resource.data)
        && (canPublishContent() || (request.resource.data.published == false
          && (!('publishedAt' in request.resource.data) || request.resource.data.publishedAt == null)));
      allow update: if collectionName in ['news','events','pages','societies','sports','leadership']
        && canWriteContent() && validRecord(request.resource.data, collectionName, id)
        && validUpdateOwnership()
        && (canPublishContent() || editorDraftUpdateOnly());
      allow delete: if collectionName in ['news','events','pages','societies','sports','leadership']
        && canDeleteContent();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
) &&
            requiredString(data,'language',20) && data.language in ['Sinhala','Tamil','English'] &&
            optionalString(data,'term',80) && requiredString(data,'url',2048) && validHttpsUrl(data,'url'))
          || (collectionName == 'leadership' &&
            data.keys().hasOnly(['title','description','role','imageUrl','published','rank','createdAt','updatedAt','publishedAt','createdBy','updatedBy']) &&
            optionalString(data,'description',1200) && requiredString(data,'role',80) && validLeaderRole(data))
        );
    }
    // Client append-only log: trusted Admin SDK changes need separate audit coverage.
    match /roleAudit/{eventId} {
      allow get, list: if isSuperAdmin();
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasAll(['actorUid','targetUid','action','beforeRole','afterRole','createdAt'])
        && request.resource.data.keys().hasOnly(['actorUid','targetUid','action','beforeRole','afterRole','createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.action in ['grant','change','revoke']
        && (request.resource.data.beforeRole == null || validManagedRole(request.resource.data.beforeRole))
        && (request.resource.data.afterRole == null || validManagedRole(request.resource.data.afterRole))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /admins/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() && validRoleProvision(uid);
      allow update: if isSuperAdmin() && validRoleUpdate(uid);
      allow delete: if isSuperAdmin() && uid != request.auth.uid
        && resource.data.role != 'super_admin';
    }
    match /{collectionName}/{id} {
      allow get, list: if collectionName in ['news','events','pages','societies','sports','leadership','pastPapers']
        && (canReview() || resource.data.published == true);
      allow create: if collectionName in ['news','events','pages','societies','sports','leadership']
        && canWriteContent() && validRecord(request.resource.data, collectionName, id)
        && validOwnership(request.resource.data)
        && (canPublishContent() || (request.resource.data.published == false
          && (!('publishedAt' in request.resource.data) || request.resource.data.publishedAt == null)));
      allow update: if collectionName in ['news','events','pages','societies','sports','leadership']
        && canWriteContent() && validRecord(request.resource.data, collectionName, id)
        && validUpdateOwnership()
        && (canPublishContent() || editorDraftUpdateOnly());
      allow delete: if collectionName in ['news','events','pages','societies','sports','leadership']
        && canDeleteContent();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
